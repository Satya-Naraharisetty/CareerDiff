# ==============================================================================
# CareerDiff Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API & WebSocket Endpoint
# - Local development: Leave empty to use Vite's internal proxy (http://localhost:8000)
# - Production (e.g., Vercel deployment): Set to your deployed Render URL (e.g. https://careerdiff-backend.onrender.com)
VITE_API_URL=

# Google OAuth 2.0 Web Client ID
# - Required for Google Sign-In button and One-Tap
# - Must match GOOGLE_CLIENT_ID configured in backend
VITE_GOOGLE_CLIENT_ID=

# Local Development: Skip login authentication gate (switchable: true | false)
VITE_SKIP_AUTH=false
