# ==============================================================================
# CareerDiff Backend Environment Configuration (.env.example)
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
UV_LINK_MODE=copy

# Concurrency (1 worker recommended for 512 MB Render free tier)
WEB_CONCURRENCY=1

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16 with asyncpg)
# ------------------------------------------------------------------------------
# Local (Docker Compose):
DATABASE_URL=postgresql+asyncpg://careerdiff:postgres@localhost:5432/careerdiff_dev
TEST_DATABASE_URL=postgresql+asyncpg://careerdiff:postgres@localhost:5432/careerdiff_test

# Production (Supabase Transaction Pooler, Port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# Redis Cache & Ephemeral Session Store
# ------------------------------------------------------------------------------
# Local (Docker Compose):
REDIS_URL=redis://localhost:6379/0

# Production (Upstash Redis):
# REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# ------------------------------------------------------------------------------
# Generate 32-byte secret in Python: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=insecure_dev_secret_change_in_production_key_32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# S3 / Object Storage (Resumes and Audio)
# ------------------------------------------------------------------------------
# Local (MinIO in Docker Compose):
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=careerdiff-resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Production (Supabase S3-compatible Storage or AWS S3 / Cloudflare R2):
# S3_ENDPOINT_URL=https://[REF].supabase.co/storage/v1/s3
# S3_BUCKET_NAME=careerdiff-resumes
# S3_ACCESS_KEY=[SUPABASE_S3_ACCESS_KEY]
# S3_SECRET_KEY=[SUPABASE_S3_SECRET_KEY]

# ------------------------------------------------------------------------------
# AI Provider API Keys & Model Routing
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_TURN_MODEL=gemini-3.8-flash
GEMINI_EVAL_MODEL=gemini-4-argon

# Optional Voice Providers (Phase 5)
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (SSO)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
