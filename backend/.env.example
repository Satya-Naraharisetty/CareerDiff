# Environment Configuration — IntervueX Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
UV_LINK_MODE=copy

# Database Configuration (Async PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://intervuex:postgres@localhost:5432/intervuex_dev
TEST_DATABASE_URL=postgresql+asyncpg://intervuex:postgres@localhost:5432/intervuex_test

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET_KEY=insecure_dev_secret_change_in_production_key_32bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# S3 / MinIO Blob Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=intervuex-resumes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# AI Provider API Keys
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
